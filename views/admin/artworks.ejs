<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    /* ===== Admin Panel Styles ===== */
    :root {
      --admin-bg: #0A0A0A;
      --admin-surface: #111111;
      --admin-surface-hover: #1A1A1A;
      --admin-border: rgba(255,255,255,0.08);
      --admin-text: #FDFBF7;
      --admin-muted: #8A8A8A;
      --admin-accent: #C17C59;
      --admin-danger: #E74C3C;
      --admin-success: #27AE60;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--admin-bg);
      color: var(--admin-text);
      line-height: 1.6;
      min-height: 100vh;
    }

    .admin-layout {
      display: flex;
      min-height: 100vh;
    }

    /* --- Sidebar --- */
    .admin-sidebar {
      width: 260px;
      background: var(--admin-surface);
      border-right: 1px solid var(--admin-border);
      padding: 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 100;
    }

    .admin-sidebar-brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 2.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--admin-border);
      text-decoration: none;
      color: var(--admin-text);
    }

    .admin-sidebar-brand img {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
    }

    .admin-sidebar-brand span {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 500;
    }

    .admin-nav { list-style: none; flex: 1; }

    .admin-nav a {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      color: var(--admin-muted);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: all 0.2s ease;
      margin-bottom: 0.25rem;
    }

    .admin-nav a:hover,
    .admin-nav a.active {
      background: rgba(193, 124, 89, 0.1);
      color: var(--admin-accent);
    }

    .admin-nav a i { width: 20px; text-align: center; }

    .admin-sidebar-footer {
      padding-top: 1rem;
      border-top: 1px solid var(--admin-border);
    }

    .admin-sidebar-footer a {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--admin-muted);
      text-decoration: none;
      font-size: 0.85rem;
      padding: 0.5rem 0;
      transition: color 0.2s;
    }

    .admin-sidebar-footer a:hover { color: var(--admin-text); }

    /* --- Main Content --- */
    .admin-main {
      flex: 1;
      margin-left: 260px;
      padding: 2rem 2.5rem;
    }

    .admin-topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .admin-topbar h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      font-weight: 500;
    }

    .admin-topbar-actions { display: flex; gap: 0.75rem; }

    /* --- Buttons --- */
    .admin-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.25rem;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
      font-family: inherit;
    }

    .admin-btn--primary {
      background: var(--admin-accent);
      color: white;
    }
    .admin-btn--primary:hover { background: #A06847; transform: translateY(-1px); }

    .admin-btn--ghost {
      background: transparent;
      color: var(--admin-muted);
      border: 1px solid var(--admin-border);
    }
    .admin-btn--ghost:hover { background: var(--admin-surface-hover); color: var(--admin-text); }

    .admin-btn--danger {
      background: transparent;
      color: var(--admin-danger);
      border: 1px solid rgba(231, 76, 60, 0.2);
    }
    .admin-btn--danger:hover { background: rgba(231, 76, 60, 0.1); }

    .admin-btn--sm { padding: 0.4rem 0.8rem; font-size: 0.8rem; }

    /* --- Stats Cards --- */
    .admin-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .admin-stat-card {
      background: var(--admin-surface);
      border: 1px solid var(--admin-border);
      border-radius: 16px;
      padding: 1.5rem;
    }

    .admin-stat-card .stat-label {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--admin-muted);
      margin-bottom: 0.5rem;
    }

    .admin-stat-card .stat-value {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.2rem;
      font-weight: 600;
      color: var(--admin-text);
    }

    /* --- Table --- */
    .admin-table-wrapper {
      background: var(--admin-surface);
      border: 1px solid var(--admin-border);
      border-radius: 16px;
      overflow: hidden;
    }

    .admin-table-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--admin-border);
    }

    .admin-table-header h3 {
      font-size: 1rem;
      font-weight: 600;
    }

    .admin-table-search {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--admin-bg);
      border: 1px solid var(--admin-border);
      border-radius: 8px;
      padding: 0.4rem 0.75rem;
    }

    .admin-table-search i { color: var(--admin-muted); font-size: 0.8rem; }

    .admin-table-search input {
      background: transparent;
      border: none;
      outline: none;
      color: var(--admin-text);
      font-size: 0.85rem;
      width: 200px;
      font-family: inherit;
    }

    .admin-table-search input::placeholder { color: var(--admin-muted); }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead th {
      padding: 0.85rem 1.5rem;
      text-align: left;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--admin-muted);
      border-bottom: 1px solid var(--admin-border);
    }

    tbody tr {
      border-bottom: 1px solid var(--admin-border);
      transition: background 0.15s ease;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: var(--admin-surface-hover); }

    tbody td {
      padding: 1rem 1.5rem;
      font-size: 0.9rem;
      vertical-align: middle;
    }

    .table-artwork-cell {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .table-artwork-thumb {
      width: 56px;
      height: 42px;
      border-radius: 8px;
      overflow: hidden;
      flex-shrink: 0;
    }

    .table-artwork-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .table-artwork-name {
      font-weight: 600;
      color: var(--admin-text);
    }

    .table-category {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: rgba(193, 124, 89, 0.1);
      color: var(--admin-accent);
    }

    .table-status {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
      font-weight: 500;
    }

    .table-status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
    }

    .table-status-dot--available { background: var(--admin-success); }
    .table-status-dot--sold { background: var(--admin-danger); }

    .table-actions {
      display: flex;
      gap: 0.4rem;
    }

    /* --- Modal --- */
    .admin-modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
      z-index: 1000;
      justify-content: center;
      align-items: flex-start;
      padding: 4rem 1rem;
      overflow-y: auto;
    }

    .admin-modal-overlay.active { display: flex; }

    .admin-modal {
      background: var(--admin-surface);
      border: 1px solid var(--admin-border);
      border-radius: 20px;
      width: 100%;
      max-width: 600px;
      animation: modalSlideIn 0.3s ease;
    }

    @keyframes modalSlideIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .admin-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 2rem;
      border-bottom: 1px solid var(--admin-border);
    }

    .admin-modal-header h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.4rem;
      font-weight: 500;
    }

    .admin-modal-close {
      background: none;
      border: none;
      color: var(--admin-muted);
      font-size: 1.2rem;
      cursor: pointer;
      padding: 0.25rem;
      transition: color 0.2s;
    }

    .admin-modal-close:hover { color: var(--admin-text); }

    .admin-modal-body { padding: 2rem; }

    .admin-form-group {
      margin-bottom: 1.25rem;
    }

    .admin-form-group label {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--admin-muted);
      margin-bottom: 0.5rem;
    }

    .admin-form-group input,
    .admin-form-group select,
    .admin-form-group textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      background: var(--admin-bg);
      border: 1px solid var(--admin-border);
      border-radius: 10px;
      color: var(--admin-text);
      font-size: 0.9rem;
      font-family: inherit;
      transition: border-color 0.2s;
    }

    .admin-form-group input:focus,
    .admin-form-group select:focus,
    .admin-form-group textarea:focus {
      outline: none;
      border-color: var(--admin-accent);
    }

    .admin-form-group textarea { resize: vertical; min-height: 100px; }

    .admin-form-group select option {
      background: var(--admin-bg);
      color: var(--admin-text);
    }

    .admin-form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .admin-form-group .image-preview {
      margin-top: 0.5rem;
      width: 100%;
      max-height: 200px;
      border-radius: 10px;
      object-fit: cover;
      display: none;
    }

    .admin-form-group .image-preview.visible { display: block; }

    .admin-form-check {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .admin-form-check input[type="checkbox"] {
      width: 18px;
      height: 18px;
      accent-color: var(--admin-accent);
    }

    .admin-form-check label {
      margin-bottom: 0;
      text-transform: none;
      font-size: 0.9rem;
      color: var(--admin-text);
    }

    .admin-modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
      padding: 1.25rem 2rem;
      border-top: 1px solid var(--admin-border);
    }

    /* --- Toast Notification --- */
    .admin-toast {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      padding: 1rem 1.5rem;
      border-radius: 12px;
      font-size: 0.9rem;
      font-weight: 500;
      z-index: 2000;
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.3s ease;
    }

    .admin-toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    .admin-toast--success {
      background: var(--admin-success);
      color: white;
    }

    .admin-toast--error {
      background: var(--admin-danger);
      color: white;
    }

    /* --- Responsive --- */
    @media (max-width: 1024px) {
      .admin-sidebar { width: 220px; }
      .admin-main { margin-left: 220px; }
    }

    @media (max-width: 768px) {
      .admin-sidebar {
        width: 100%;
        position: relative;
        border-right: none;
        border-bottom: 1px solid var(--admin-border);
        padding: 1rem;
      }
      .admin-main {
        margin-left: 0;
        padding: 1.5rem;
      }
      .admin-layout { flex-direction: column; }
      .admin-form-row { grid-template-columns: 1fr; }
      .admin-stats { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>
  <!-- Background particles canvas -->
  <canvas id="particle-canvas" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: -1;"></canvas>

  <!-- Sidebar navigation -->
  <aside class="admin-sidebar">
    <a href="/" class="admin-sidebar-brand">
      <img src="/images/logo.jpeg" alt="RangKala" />
      <span>RangKala</span>
    </a>

    <ul class="admin-nav">
      <li><a href="/admin/homepage-gallery"><i class="fas fa-house"></i> Homepage Gallery</a></li>
      <li><a href="/admin/artworks" class="active"><i class="fas fa-palette"></i> Artworks</a></li>
      <li><a href="/admin/services"><i class="fas fa-concierge-bell"></i> Services</a></li>
      <li><a href="/admin/workshops"><i class="fas fa-chalkboard-teacher"></i> Workshops</a></li>
      <li><a href="/admin/events"><i class="fas fa-images"></i> Event Gallery</a></li>
      <li><a href="/admin/testimonials"><i class="fas fa-quote-left"></i> Testimonials</a></li>
      <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
      <li><a href="/"><i class="fas fa-globe"></i> View Site</a></li>
      <li><a href="/artworks"><i class="fas fa-store"></i> Catalog Page</a></li>
    </ul>

    <div class="admin-sidebar-footer">
      <a href="/"><i class="fas fa-arrow-left"></i> Back to Website</a>
    </div>
  </aside>

  <!-- Main panel content -->
  <main class="admin-main">
    <div class="admin-topbar">
      <h1>Manage Artworks</h1>
      <div class="admin-topbar-actions">
        <a href="/artworks" class="admin-btn admin-btn--ghost" target="_blank">
          <i class="fas fa-external-link-alt"></i> View Catalog
        </a>
        <button class="admin-btn admin-btn--primary" id="btn-add-artwork">
          <i class="fas fa-plus"></i> Add Artwork
        </button>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: rgba(231, 76, 60, 0.1); border: 1px solid var(--admin-danger); color: var(--admin-danger); padding: 1rem 1.5rem; border-radius: 10px; margin-bottom: 2rem;">
        <%= error %>
      </div>
    <% } %>

    <!-- Statistics cards -->
    <div class="admin-stats">
      <div class="admin-stat-card">
        <div class="stat-label">Total Artworks</div>
        <div class="stat-value"><%= artworks.length %></div>
      </div>
      <div class="admin-stat-card">
        <div class="stat-label">Available</div>
        <div class="stat-value"><%= artworks.filter(a => a.available).length %></div>
      </div>
      <div class="admin-stat-card">
        <div class="stat-label">Sold</div>
        <div class="stat-value"><%= artworks.filter(a => !a.available).length %></div>
      </div>
      <div class="admin-stat-card">
        <div class="stat-label">Categories</div>
        <div class="stat-value"><%= categories.length %></div>
      </div>
    </div>

    <!-- Artworks management table -->
    <div class="admin-table-wrapper">
      <div class="admin-table-header">
        <h3>All Artworks</h3>
        <div class="admin-table-search">
          <i class="fas fa-search"></i>
          <input type="text" placeholder="Search artworks..." id="admin-search" />
        </div>
      </div>

      <table>
        <thead>
          <tr>
            <th>Artwork</th>
            <th>Category</th>
            <th>Price</th>
            <th>Status</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="admin-table-body">
          <% artworks.forEach(function(art) { %>
            <tr data-id="<%= art.id %>" data-name="<%= art.name.toLowerCase() %>">
              <td>
                <div class="table-artwork-cell">
                  <div class="table-artwork-thumb">
                    <img src="<%= art.image %>" alt="<%= art.name %>" />
                  </div>
                  <span class="table-artwork-name"><%= art.name %></span>
                </div>
              </td>
              <td><span class="table-category"><%= art.category %></span></td>
              <td><%= art.price || '—' %></td>
              <td>
                <span class="table-status">
                  <span class="table-status-dot <%= art.available ? 'table-status-dot--available' : 'table-status-dot--sold' %>"></span>
                  <%= art.available ? 'Available' : 'Sold' %>
                </span>
              </td>
              <td style="color: var(--admin-muted); font-size: 0.85rem;"><%= art.createdAt %></td>
              <td>
                <div class="table-actions">
                  <button class="admin-btn admin-btn--ghost admin-btn--sm btn-edit" data-id="<%= art.id %>">
                    <i class="fas fa-pen"></i>
                  </button>
                  <button class="admin-btn admin-btn--danger admin-btn--sm btn-delete" data-id="<%= art.id %>" data-name="<%= art.name %>">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</div>

<!-- Naya add / edit karne ka modal -->
<div class="admin-modal-overlay" id="artwork-modal">
  <div class="admin-modal">
    <div class="admin-modal-header">
      <h2 id="modal-title">Add New Artwork</h2>
      <button class="admin-modal-close" id="modal-close">&times;</button>
    </div>

    <form id="artwork-form" enctype="multipart/form-data">
      <div class="admin-modal-body">
        <input type="hidden" id="form-id" />

        <div class="admin-form-group">
          <label for="form-name">Artwork Name *</label>
          <input type="text" id="form-name" name="name" required placeholder="e.g. Sunset Horizon Mural" />
        </div>

        <div class="admin-form-row">
          <div class="admin-form-group">
            <label for="form-category">Category *</label>
            <select id="form-category" name="category" required>
              <option value="">Select category</option>
              <option value="Wall Murals">Wall Murals</option>
              <option value="Canvas Art">Canvas Art</option>
              <option value="Room Paintings">Room Paintings</option>
              <option value="Building Exteriors">Building Exteriors</option>
              <option value="Custom Art">Custom Art</option>
              <option value="Hotel & Resort Art">Hotel & Resort Art</option>
            </select>
          </div>
          <div class="admin-form-group">
            <label for="form-medium">Medium</label>
            <input type="text" id="form-medium" name="medium" placeholder="e.g. Acrylic on Canvas" />
          </div>
        </div>

        <div class="admin-form-group">
          <label for="form-description">Description</label>
          <textarea id="form-description" name="description" placeholder="Describe the artwork..."></textarea>
        </div>

        <div class="admin-form-row">
          <div class="admin-form-group">
            <label for="form-dimensions">Dimensions</label>
            <input type="text" id="form-dimensions" name="dimensions" placeholder="e.g. 36&quot; × 48&quot;" />
          </div>
          <div class="admin-form-group">
            <label for="form-price">Price</label>
            <input type="text" id="form-price" name="price" placeholder="e.g. ₹25,000" />
          </div>
        </div>

        <div class="admin-form-group">
          <label for="form-tags">Tags (comma separated)</label>
          <input type="text" id="form-tags" name="tags" placeholder="e.g. modern, vibrant, bedroom" />
        </div>

        <div class="admin-form-group">
          <label for="form-image">Image (Upload)</label>
          <input type="file" id="form-image" name="image" accept="image/*" />
          <img class="image-preview" id="image-preview" alt="Preview" />
        </div>

        <div class="admin-form-group">
          <label for="form-image-url">Or paste image URL</label>
          <input type="url" id="form-image-url" name="imageUrl" placeholder="https://..." />
        </div>

        <div class="admin-form-group">
          <div class="admin-form-check">
            <input type="checkbox" id="form-available" name="available" checked />
            <label for="form-available">Available for purchase</label>
          </div>
        </div>
      </div>

      <div class="admin-modal-footer">
        <button type="button" class="admin-btn admin-btn--ghost" id="modal-cancel">Cancel</button>
        <button type="submit" class="admin-btn admin-btn--primary" id="modal-submit">
          <i class="fas fa-save"></i> Save Artwork
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Delete confirmation modal -->
<div class="admin-modal-overlay" id="delete-modal">
  <div class="admin-modal" style="max-width: 420px;">
    <div class="admin-modal-header">
      <h2>Confirm Delete</h2>
      <button class="admin-modal-close" onclick="document.getElementById('delete-modal').classList.remove('active')">&times;</button>
    </div>
    <div class="admin-modal-body" style="text-align: center; padding: 2rem;">
      <i class="fas fa-exclamation-triangle" style="font-size: 2.5rem; color: var(--admin-danger); margin-bottom: 1rem;"></i>
      <p style="font-size: 1rem; margin-bottom: 0.5rem;">Are you sure you want to delete</p>
      <p style="font-weight: 600; font-size: 1.1rem;" id="delete-name"></p>
      <p style="color: var(--admin-muted); font-size: 0.85rem; margin-top: 0.5rem;">This action cannot be undone.</p>
    </div>
    <div class="admin-modal-footer" style="justify-content: center;">
      <button class="admin-btn admin-btn--ghost" onclick="document.getElementById('delete-modal').classList.remove('active')">Cancel</button>
      <button class="admin-btn admin-btn--danger" id="confirm-delete">
        <i class="fas fa-trash"></i> Delete
      </button>
    </div>
  </div>
</div>

