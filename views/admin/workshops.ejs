<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    :root {
      --admin-bg: #0A0A0A; --admin-surface: #111111; --admin-surface-hover: #1A1A1A;
      --admin-border: rgba(255,255,255,0.08); --admin-text: #FDFBF7; --admin-muted: #8A8A8A;
      --admin-accent: #C17C59; --admin-danger: #E74C3C; --admin-success: #27AE60;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background: var(--admin-bg); color: var(--admin-text); line-height: 1.6; min-height: 100vh; }
    .admin-sidebar { width: 260px; background: var(--admin-surface); border-right: 1px solid var(--admin-border); padding: 2rem 1.5rem; display: flex; flex-direction: column; position: fixed; top: 0; left: 0; bottom: 0; z-index: 100; }
    .admin-sidebar-brand { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--admin-border); text-decoration: none; color: var(--admin-text); }
    .admin-sidebar-brand img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
    .admin-sidebar-brand span { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; font-weight: 500; }
    .admin-nav { list-style: none; flex: 1; }
    .admin-nav a { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 10px; color: var(--admin-muted); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: all 0.2s ease; margin-bottom: 0.25rem; }
    .admin-nav a:hover, .admin-nav a.active { background: rgba(193, 124, 89, 0.1); color: var(--admin-accent); }
    .admin-nav a i { width: 20px; text-align: center; }
    .admin-sidebar-footer { padding-top: 1rem; border-top: 1px solid var(--admin-border); }
    .admin-sidebar-footer a { display: flex; align-items: center; gap: 0.5rem; color: var(--admin-muted); text-decoration: none; font-size: 0.85rem; padding: 0.5rem 0; transition: color 0.2s; }
    .admin-sidebar-footer a:hover { color: var(--admin-text); }
    .admin-main { margin-left: 260px; padding: 2rem 2.5rem; }
    .admin-topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
    .admin-topbar h1 { font-family: 'Cormorant Garamond', serif; font-size: 2rem; font-weight: 500; }
    .admin-topbar-actions { display: flex; gap: 0.75rem; }
    .admin-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.65rem 1.25rem; border-radius: 10px; font-size: 0.85rem; font-weight: 600; border: none; cursor: pointer; transition: all 0.2s ease; text-decoration: none; font-family: inherit; }
    .admin-btn--primary { background: var(--admin-accent); color: white; }
    .admin-btn--primary:hover { background: #A06847; transform: translateY(-1px); }
    .admin-btn--ghost { background: transparent; color: var(--admin-muted); border: 1px solid var(--admin-border); }
    .admin-btn--ghost:hover { background: var(--admin-surface-hover); color: var(--admin-text); }
    .admin-btn--danger { background: transparent; color: var(--admin-danger); border: 1px solid rgba(231, 76, 60, 0.2); }
    .admin-btn--danger:hover { background: rgba(231, 76, 60, 0.1); }
    .admin-btn--sm { padding: 0.4rem 0.8rem; font-size: 0.8rem; }

    .admin-section-card { background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: 16px; padding: 1.5rem 1.75rem; margin-bottom: 2rem; }
    .admin-section-card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem; }
    .admin-section-card h3 i { color: var(--admin-accent); }

    .admin-form-group { margin-bottom: 1.1rem; }
    .admin-form-group label { display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--admin-muted); margin-bottom: 0.5rem; }
    .admin-form-group input, .admin-form-group textarea { width: 100%; padding: 0.7rem 1rem; background: var(--admin-bg); border: 1px solid var(--admin-border); border-radius: 10px; color: var(--admin-text); font-size: 0.9rem; font-family: inherit; transition: border-color 0.2s; }
    .admin-form-group input:focus, .admin-form-group textarea:focus { outline: none; border-color: var(--admin-accent); }
    .admin-form-group textarea { resize: vertical; min-height: 70px; }
    .admin-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .admin-form-row--4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }

    .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }
    .card-tile { background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; }
    .card-tile-img { height: 150px; background: var(--admin-bg); }
    .card-tile-img img { width: 100%; height: 100%; object-fit: cover; }
    .card-tile-body { padding: 1.1rem 1.25rem; flex: 1; display: flex; flex-direction: column; }
    .card-tile-title { font-weight: 600; margin-bottom: 0.4rem; }
    .card-tile-desc { font-size: 0.82rem; color: var(--admin-muted); flex: 1; margin-bottom: 1rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .card-tile-actions { display: flex; gap: 0.5rem; }
    .card-tile-order { font-size: 0.7rem; color: var(--admin-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }

    .empty-state { padding: 3rem 2rem; text-align: center; color: var(--admin-muted); grid-column: 1/-1; }
    .empty-state i { font-size: 2rem; margin-bottom: 0.75rem; opacity: 0.5; }

    .admin-modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px); z-index: 1000; justify-content: center; align-items: flex-start; padding: 4rem 1rem; overflow-y: auto; }
    .admin-modal-overlay.active { display: flex; }
    .admin-modal { background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: 20px; width: 100%; max-width: 560px; }
    .admin-modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2rem; border-bottom: 1px solid var(--admin-border); }
    .admin-modal-header h2 { font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; font-weight: 500; }
    .admin-modal-close { background: none; border: none; color: var(--admin-muted); font-size: 1.2rem; cursor: pointer; padding: 0.25rem; }
    .admin-modal-close:hover { color: var(--admin-text); }
    .admin-modal-body { padding: 2rem; }
    .admin-modal-footer { display: flex; justify-content: flex-end; gap: 0.75rem; padding: 1.25rem 2rem; border-top: 1px solid var(--admin-border); }
    .image-preview { margin-top: 0.5rem; width: 100%; max-height: 180px; border-radius: 10px; object-fit: cover; display: none; }
    .image-preview.visible { display: block; }

    .admin-toast { position: fixed; bottom: 2rem; right: 2rem; padding: 1rem 1.5rem; border-radius: 12px; font-size: 0.9rem; font-weight: 500; z-index: 2000; transform: translateY(100px); opacity: 0; transition: all 0.3s ease; }
    .admin-toast.show { transform: translateY(0); opacity: 1; }
    .admin-toast--success { background: var(--admin-success); color: white; }
    .admin-toast--error { background: var(--admin-danger); color: white; }

    @media (max-width: 1024px) { .admin-sidebar { width: 220px; } .admin-main { margin-left: 220px; } }
    @media (max-width: 768px) {
      .admin-sidebar { width: 100%; position: relative; border-right: none; border-bottom: 1px solid var(--admin-border); padding: 1rem; }
      .admin-main { margin-left: 0; padding: 1.5rem; }
      body { display: flex; flex-direction: column; }
      .admin-form-row, .admin-form-row--4 { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <canvas id="particle-canvas" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: -1;"></canvas>

  <aside class="admin-sidebar">
    <a href="/" class="admin-sidebar-brand">
      <img src="/images/logo.jpeg" alt="RangKala" />
      <span>RangKala</span>
    </a>
    <ul class="admin-nav">
      <li><a href="/admin/homepage-gallery"><i class="fas fa-house"></i> Homepage Gallery</a></li>
      <li><a href="/admin/artworks"><i class="fas fa-palette"></i> Artworks</a></li>
      <li><a href="/admin/services"><i class="fas fa-concierge-bell"></i> Services</a></li>
      <li><a href="/admin/workshops" class="active"><i class="fas fa-chalkboard-teacher"></i> Workshops</a></li>
      <li><a href="/admin/events"><i class="fas fa-images"></i> Event Gallery</a></li>
      <li><a href="/admin/testimonials"><i class="fas fa-quote-left"></i> Testimonials</a></li>
      <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
      <li><a href="/"><i class="fas fa-globe"></i> View Site</a></li>
    </ul>
    <div class="admin-sidebar-footer">
      <a href="/admin/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>
  </aside>

  <main class="admin-main">
    <div class="admin-topbar">
      <h1>Manage Workshops</h1>
      <div class="admin-topbar-actions">
        <a href="/portfolio" class="admin-btn admin-btn--ghost" target="_blank"><i class="fas fa-external-link-alt"></i> View Page</a>
        <button class="admin-btn admin-btn--primary" id="btn-add-card"><i class="fas fa-plus"></i> Add Program</button>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: rgba(231, 76, 60, 0.1); border: 1px solid var(--admin-danger); color: var(--admin-danger); padding: 1rem 1.5rem; border-radius: 10px; margin-bottom: 2rem;"><%= error %></div>
    <% } %>

    <!-- Page header / CTA settings -->
    <div class="admin-section-card">
      <h3><i class="fas fa-heading"></i> Page Header &amp; Stats</h3>
      <form id="page-settings-form">
        <div class="admin-form-row">
          <div class="admin-form-group">
            <label>Label (small text above title)</label>
            <input type="text" name="label" value="<%= page.label %>" />
          </div>
          <div class="admin-form-group">
            <label>Page Title</label>
            <input type="text" name="title" value="<%= page.title %>" />
          </div>
        </div>
        <div class="admin-form-group">
          <label>Subtitle</label>
          <textarea name="subtitle"><%= page.subtitle %></textarea>
        </div>
        <div class="admin-form-row--4">
          <div class="admin-form-group">
            <label>Workshops Stat</label>
            <input type="text" name="statWorkshops" value="<%= page.statWorkshops %>" placeholder="50+" />
          </div>
          <div class="admin-form-group">
            <label>Students Stat</label>
            <input type="text" name="statStudents" value="<%= page.statStudents %>" placeholder="5000+" />
          </div>
          <div class="admin-form-group">
            <label>Institutions Stat</label>
            <input type="text" name="statInstitutions" value="<%= page.statInstitutions %>" placeholder="30+" />
          </div>
          <div class="admin-form-group">
            <label>Years Stat</label>
            <input type="text" name="statYears" value="<%= page.statYears %>" placeholder="8+" />
          </div>
        </div>
        <button type="submit" class="admin-btn admin-btn--primary"><i class="fas fa-save"></i> Save Page Settings</button>
      </form>
    </div>

    <!-- Cards -->
    <div class="admin-section-card">
      <h3><i class="fas fa-concierge-bell"></i> Program Cards</h3>
      <div class="cards-grid" id="cards-grid">
        <% if (cards.length === 0) { %>
          <div class="empty-state"><i class="fas fa-inbox"></i><p>No workshop programs yet. Click "Add Program" to create one.</p></div>
        <% } %>
        <% cards.forEach(function(card, i) { %>
          <div class="card-tile" data-id="<%= card.id %>">
            <div class="card-tile-img"><img src="<%= card.image %>" alt="<%= card.title %>" /></div>
            <div class="card-tile-body">
              <div class="card-tile-order">#<%= i + 1 %></div>
              <div class="card-tile-title"><%= card.title %></div>
              <div class="card-tile-desc"><%= card.description %></div>
              <div class="card-tile-actions">
                <button class="admin-btn admin-btn--ghost admin-btn--sm btn-edit"
                  data-id="<%= card.id %>" data-title="<%= card.title %>"
                  data-description="<%= card.description %>" data-image="<%= card.image %>"
                  data-cta-text="<%= card.ctaText %>" data-cta-link="<%= card.ctaLink %>">
                  <i class="fas fa-pen"></i> Edit
                </button>
                <button class="admin-btn admin-btn--danger admin-btn--sm btn-delete" data-id="<%= card.id %>" data-title="<%= card.title %>">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </main>

  <!-- Add / Edit card modal -->
  <div class="admin-modal-overlay" id="card-modal">
    <div class="admin-modal">
      <div class="admin-modal-header">
        <h2 id="modal-title">Add Program</h2>
        <button class="admin-modal-close" id="modal-close">&times;</button>
      </div>
      <form id="card-form" enctype="multipart/form-data">
        <div class="admin-modal-body">
          <input type="hidden" id="form-id" />
          <div class="admin-form-group">
            <label for="form-title">Title *</label>
            <input type="text" id="form-title" name="title" required placeholder="e.g. College Workshops" />
          </div>
          <div class="admin-form-group">
            <label for="form-description">Description</label>
            <textarea id="form-description" name="description" placeholder="Describe this service..."></textarea>
          </div>
          <div class="admin-form-row">
            <div class="admin-form-group">
              <label for="form-cta-text">Button Text</label>
              <input type="text" id="form-cta-text" name="ctaText" placeholder="Enquire Now" />
            </div>
            <div class="admin-form-group">
              <label for="form-cta-link">Button Link</label>
              <input type="text" id="form-cta-link" name="ctaLink" placeholder="/contact" />
            </div>
          </div>
          <div class="admin-form-group">
            <label for="form-image">Image (Upload)</label>
            <input type="file" id="form-image" name="image" accept="image/*" />
            <img class="image-preview" id="image-preview" alt="Preview" />
          </div>
          <div class="admin-form-group">
            <label for="form-image-url">Or paste image URL</label>
            <input type="url" id="form-image-url" name="imageUrl" placeholder="https://..." />
          </div>
        </div>
        <div class="admin-modal-footer">
          <button type="button" class="admin-btn admin-btn--ghost" id="modal-cancel">Cancel</button>
          <button type="submit" class="admin-btn admin-btn--primary" id="modal-submit"><i class="fas fa-save"></i> Save</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete confirm modal -->
  <div class="admin-modal-overlay" id="delete-modal">
    <div class="admin-modal" style="max-width: 420px;">
      <div class="admin-modal-header">
        <h2>Confirm Delete</h2>
        <button class="admin-modal-close" onclick="document.getElementById('delete-modal').classList.remove('active')">&times;</button>
      </div>
      <div class="admin-modal-body" style="text-align: center; padding: 2rem;">
        <i class="fas fa-exclamation-triangle" style="font-size: 2.5rem; color: var(--admin-danger); margin-bottom: 1rem;"></i>
        <p>Are you sure you want to delete</p>
        <p style="font-weight: 600; font-size: 1.1rem;" id="delete-name"></p>
      </div>
      <div class="admin-modal-footer" style="justify-content: center;">
        <button class="admin-btn admin-btn--ghost" onclick="document.getElementById('delete-modal').classList.remove('active')">Cancel</button>
        <button class="admin-btn admin-btn--danger" id="confirm-delete"><i class="fas fa-trash"></i> Delete</button>
      </div>
    </div>
  </div>

  <div class="admin-toast" id="admin-toast"></div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="/js/particles.js"></script>
  <script>window.CONTENT_CARD_TYPE = 'workshop';</script>
  <script src="/js/admin-content.js"></script>
</body>
</html>
