<%- include('partials/header') %>

<!-- Page header -->
<section class="page-header">
  <div class="container">
    <div class="label reveal">START YOUR PROJECT</div>
    <h1 class="display-lg word-reveal">Book a Painting Slot</h1>
    <p class="subtitle reveal">
      Fill out the form below and we'll get back to you within 24 hours
    </p>
  </div>
</section>

<!-- Booking form section -->
<section class="section" style="padding-top: 0;">
  <div class="container">
    <div class="form-card reveal-scale">
      <form id="booking-form">
        <!-- Service selection dropdown -->
        <div class="form-group">
          <label>Service <span>*</span></label>
          <select name="service" class="form-select" required>
            <option value="" disabled selected>Select a service</option>
            <option value="Room Wall Paintings">Room Wall Paintings</option>
            <option value="Hotel & Resort Art">Hotel & Resort Art</option>
            <option value="Building Exterior Paintings">Building Exterior Paintings</option>
            <option value="Office & Commercial Art">Office & Commercial Art</option>
            <option value="Custom Canvas Paintings">Custom Canvas Paintings</option>
          </select>
        </div>

        <!-- Personal info inputs -->
        <div class="form-row">
          <div class="form-group">
            <label>Full Name <span>*</span></label>
            <input type="text" name="name" class="form-input" placeholder="Your full name" required />
          </div>
          <div class="form-group">
            <label>Email <span>*</span></label>
            <input type="email" name="email" class="form-input" placeholder="your@email.com" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>WhatsApp Number <span>*</span></label>
            <input type="tel" name="phone" class="form-input" placeholder="+91 98765 43210" required />
          </div>
          <div class="form-group">
            <label>Preferred Date <span>*</span></label>
            <input type="date" name="preferred_date" class="form-input" required />
          </div>
        </div>

        <div class="form-group">
          <label>Address <span>*</span></label>
          <input type="text" name="address" class="form-input" placeholder="Your complete address" required />
        </div>

        <div class="form-group">
          <label>Additional Details</label>
          <textarea name="message" class="form-textarea" placeholder="Tell us about your project — dimensions, preferred style, colors, or any specific requirements..." rows="5"></textarea>
        </div>

        <button type="submit" class="btn btn-accent form-submit">
          Submit Booking Request <span class="btn-arrow">→</span>
        </button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
