<%- include('partials/header') %>

  <!-- Artwork detail page -->
  <section class="artwork-detail-page">
    <div class="container">

      <!-- Breadcrumb navigation -->
      <div class="artwork-detail-breadcrumb reveal">
        <a href="/" class="breadcrumb-link">Home</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/artworks" class="breadcrumb-link">Artworks</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">
          <%= artwork.name %>
        </span>
      </div>

      <!-- Main detail grid -->
      <div class="artwork-detail-grid">
        <!-- Artwork image preview -->
        <div class="artwork-detail-image reveal-left">
          <div class="artwork-detail-image-wrapper">
            <img src="<%= artwork.image %>" alt="<%= artwork.name %>" />
            <% if (!artwork.available) { %>
              <div class="artwork-badge artwork-badge--sold artwork-badge--lg">Sold</div>
              <% } %>
          </div>
        </div>

        <!-- Artwork information & specs -->
        <div class="artwork-detail-info reveal-right">
          <span class="label">
            <%= artwork.category %>
          </span>
          <h1 class="artwork-detail-title">
            <%= artwork.name %>
          </h1>

          <p class="artwork-detail-desc body-lg">
            <%= artwork.description %>
          </p>

          <div class="artwork-detail-specs">
            <% if (artwork.medium) { %>
              <div class="artwork-spec">
                <span class="artwork-spec-label">Medium</span>
                <span class="artwork-spec-value">
                  <%= artwork.medium %>
                </span>
              </div>
              <% } %>
                <% if (artwork.dimensions) { %>
                  <div class="artwork-spec">
                    <span class="artwork-spec-label">Dimensions</span>
                    <span class="artwork-spec-value">
                      <%= artwork.dimensions %>
                    </span>
                  </div>
                  <% } %>
                    <% if (artwork.price) { %>
                      <div class="artwork-spec">
                        <span class="artwork-spec-label">Price</span>
                        <span class="artwork-spec-value artwork-spec-price">
                          <%= artwork.price %>
                        </span>
                      </div>
                      <% } %>
                        <div class="artwork-spec">
                          <span class="artwork-spec-label">Availability</span>
                          <span class="artwork-spec-value">
                            <% if (artwork.available) { %>
                              <span class="status-dot status-dot--available"></span> Available
                              <% } else { %>
                                <span class="status-dot status-dot--sold"></span> Sold
                                <% } %>
                          </span>
                        </div>
          </div>

          <div class="artwork-detail-actions">
            <% if (artwork.available) { %>
              <a href="/book" class="btn btn-primary btn-lg">
                <i class="fas fa-palette"></i> Enquire About This Piece
              </a>
              <% } else { %>
                <a href="/book" class="btn btn-secondary btn-lg">
                  <i class="fas fa-paint-brush"></i> Commission Similar Artwork
                </a>
                <% } %>
                  <a href="https://wa.me/919936304621?text=Hi, I'm interested in the artwork: <%= encodeURIComponent(artwork.name) %>"
                    target="_blank" class="btn btn-whatsapp btn-lg">
                    <i class="fab fa-whatsapp"></i> WhatsApp Us
                  </a>
          </div>
        </div>
      </div>

      <!-- Related artworks section -->
      <% if (related && related.length> 0) { %>
        <div class="artwork-related">
          <h2 class="h2 word-reveal">Related Artworks</h2>
          <div class="artwork-related-grid">
            <% related.forEach(function(art) { %>
              <a href="/artworks/<%= art.slug %>" class="artwork-card reveal">
                <div class="artwork-card-img">
                  <img src="<%= art.image %>" alt="<%= art.name %>" loading="lazy" />
                  <div class="artwork-card-overlay"></div>
                </div>
                <div class="artwork-card-body">
                  <span class="artwork-card-category">
                    <%= art.category %>
                  </span>
                  <h3 class="artwork-card-title">
                    <%= art.name %>
                  </h3>
                  <div class="artwork-card-meta">
                    <% if (art.price) { %>
                      <span class="artwork-card-price">
                        <%= art.price %>
                      </span>
                      <% } %>
                        <span class="artwork-card-detail-link">
                          View Details <i class="fas fa-arrow-right"></i>
                        </span>
                  </div>
                </div>
              </a>
              <% }); %>
          </div>
        </div>
        <% } %>

    </div>
  </section>

  <%- include('partials/footer') %>