<%- include('partials/header') %>

<!-- Page header -->
<section class="page-header">
  <div class="container">
    <div class="label reveal">OUR STORY</div>
    <h1 class="display-lg word-reveal">About RangKala Creations</h1>
    <p class="subtitle reveal">
      Transforming spaces into artistic masterpieces through handcrafted wall paintings and custom art solutions
    </p>
  </div>
</section>

<!-- Company story section -->
<section class="section">
  <div class="container">
    <div class="location-grid">
      <div class="reveal-left">
        <h2 class="h2 reveal" style="margin: var(--space-sm) 0;">Our Story</h2>
        <div class="divider"></div>
        <p class="body-lg reveal" style="margin-bottom: var(--space-md);">
          Founded with a passion for bringing art into everyday spaces, RangKala Creations has been transforming
          walls into canvases since 2016. What started as a dream to make art accessible to everyone has grown
          into a leading creative studio specializing in custom wall paintings, murals, and artistic installations.
        </p>
        <p class="body-lg reveal">
          We believe that every space has a story to tell, and through our handcrafted artwork, we help
          bring those stories to life. From intimate home spaces to grand commercial installations,
          each project is a unique collaboration between our artistic vision and your dreams.
        </p>
      </div>
      <div class="reveal-right">
        <div class="location-img">
          <img src="/images/our-story.png" alt="Our artistic journey" class="parallax-img" data-speed="-25" />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Company stats -->
<section class="section" style="background: var(--canvas-secondary);">
  <div class="container">
    <div class="stats-row stagger-children">
      <div class="stat-item">
        <div class="stat-number">500+</div>
        <div class="stat-label">Happy Clients</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">1000+</div>
        <div class="stat-label">Artworks Created</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">8+</div>
        <div class="stat-label">Years Experience</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">100%</div>
        <div class="stat-label">Satisfaction Rate</div>
      </div>
    </div>
  </div>
</section>

<!-- Team & founders section -->
<section class="section">
  <div class="container">
    <div class="section-header" style="text-align: center;">
      <div class="label reveal">THE TEAM</div>
      <h2 class="h1 word-reveal">Meet Our Founders</h2>
      <div class="divider" style="margin: var(--space-md) auto;"></div>
      <p class="subtitle reveal" style="margin: 0 auto;">
        The creative minds behind RangKala Creations
      </p>
    </div>

    <div class="founders-grid stagger-children">
      <!-- Founder 1 -->
      <div class="founder-card">
        <div class="founder-img">
          <img src="https://images.unsplash.com/photo-1494790108755-2616b612b786?w=400&h=400&fit=crop&crop=face" alt="Priyanka Richhariya" />
        </div>
        <h3 class="founder-name reveal">Priyanka Richhariya</h3>
        <div class="founder-title reveal">Founder & Master Artist</div>
        <p class="founder-bio reveal">
          With over 8 years of experience in traditional and contemporary art forms, Priyanka specializes in
          large-scale murals and intricate wall paintings. Her expertise spans across Madhubani, abstract
          compositions, and modern architectural art.
        </p>
        <div class="founder-specialties">
          <span class="specialty-tag">Madhubani Art</span>
          <span class="specialty-tag">Wall Murals</span>
          <span class="specialty-tag">Abstract Paintings</span>
          <span class="specialty-tag">Architectural Design</span>
        </div>
      </div>

      <!-- Founder 2 -->
      <div class="founder-card">
        <div class="founder-img">
          <img src="https://image2url.com/r2/default/images/1772393635309-e485073a-4761-4a69-86e9-944108d3246a.png" alt="Bhuvnesh Richhariya" />
        </div>
        <h3 class="founder-name reveal">Bhuvnesh Richhariya</h3>
        <div class="founder-title reveal">Co-Founder & Director</div>
        <p class="founder-bio reveal">
          Bhuvnesh brings extensive business expertise and project management skills to RangKala Creations.
          He oversees client relations, project execution, and business development while ensuring every
          artwork meets the highest standards.
        </p>
        <div class="founder-specialties">
          <span class="specialty-tag">Project Management</span>
          <span class="specialty-tag">Client Relations</span>
          <span class="specialty-tag">Business Strategy</span>
          <span class="specialty-tag">Quality Assurance</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Studio location details -->
<section class="section" style="background: var(--canvas-secondary);">
  <div class="container">
    <div class="section-header" style="text-align: center;">
      <div class="label reveal">VISIT US</div>
      <h2 class="h1 word-reveal">Visit Our Studio</h2>
      <div class="divider" style="margin: var(--space-md) auto;"></div>
      <p class="subtitle reveal" style="margin: 0 auto;">
        Located at RISE Jhansi — Experience our creative workspace
      </p>
    </div>

    <div class="location-grid">
      <div class="reveal-left">
        <div class="location-img">
          <img src="/images/rise-studio.png" alt="RISE Jhansi — Our Office" />
          <span class="location-badge">Our Studio</span>
        </div>
      </div>

      <div class="location-details reveal-right">
        <h3 class="reveal">RangKala Creations Studio</h3>

        <div class="address-block">
          <i data-lucide="map-pin" style="width:20px;height:20px;"></i>
          <div>
            <p class="address-text reveal">
              RISE Jhansi<br/>
              (Rani Laxmi Bai Incubator for Sustainable Entrepreneurship)<br/>
              Jhansi Nagar Nigam premises, near Elite Chauraha<br/>
              Civil Lines, Jhansi, Uttar Pradesh 284001
            </p>
            <a href="https://maps.google.com/?q=RISE+Jhansi+Elite+Chauraha+Civil+Lines+Jhansi+Uttar+Pradesh+284001" target="_blank" style="color: var(--terracotta); font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.5rem;">
              View on Google Maps <i data-lucide="external-link" style="width:14px;height:14px;"></i>
            </a>
          </div>
        </div>

        <div class="contact-detail reveal">
          <i data-lucide="phone" style="width:18px;height:18px;"></i>
          <span>+91 99363 04621</span>
        </div>
        <div class="contact-detail reveal">
          <i data-lucide="mail" style="width:18px;height:18px;"></i>
          <span>info@rangkalacreations.com</span>
        </div>

        <div class="hours-block reveal">
          <h4 class="reveal">Working Hours</h4>
          <p class="reveal">Monday – Saturday: 10:00 AM – 6:00 PM</p>
          <p class="reveal">Sunday: By Appointment Only</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mission section -->
<section class="section">
  <div class="container container--narrow">
    <div class="mission-box reveal-scale">
      <div class="label" style="margin-bottom: var(--space-sm);">OUR MISSION</div>
      <h2 class="h2">Our Mission</h2>
      <div class="divider" style="margin: var(--space-md) auto;"></div>
      <p class="reveal">
        To make art accessible and meaningful for everyone by creating custom, handcrafted paintings
        that transform ordinary spaces into extraordinary experiences. We are committed to preserving
        traditional art forms while embracing modern techniques to serve our clients better.
      </p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
